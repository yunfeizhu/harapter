{
  "name": "@harapter/conformance",
  "version": "0.3.0",
  "description": "Reusable provider conformance tests and deterministic Fake Provider for Harapter.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunfeizhu/harapter.git",
    "directory": "packages/conformance"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./fake": {
      "types": "./dist/fake-provider.d.ts",
      "default": "./dist/fake-provider.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@harapter/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "vitest": ">=4.1.11 <5"
  },
  "private": true
}
