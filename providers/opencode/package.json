{
  "name": "@harapter/adapter-opencode",
  "version": "0.3.0",
  "description": "OpenCode HTTP provider adapter for Harapter.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunfeizhu/harapter.git",
    "directory": "providers/opencode"
  },
