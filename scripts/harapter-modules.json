      "name": "@harapter/adapter-openclaw",
      "smokeExport": "createOpenClawProviderFactory",
      "subpath": "./openclaw"
    },
    {
      "path": "providers/opencode",
      "name": "@harapter/adapter-opencode",
      "smokeExport": "createOpenCodeProviderFactory",
      "subpath": "./opencode"
    },
    {
      "path": "providers/pi",
      "name": "@harapter/adapter-pi",
