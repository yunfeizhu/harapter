{
  "capabilities": {
    "object": "hermes.api_server.capabilities",
    "platform": "hermes-agent",
    "model": "synthetic-model",
    "auth": { "type": "bearer", "required": true },
    "runtime": {
      "mode": "server_agent",
      "tool_execution": "server",
      "split_runtime": false
    },
    "features": {
      "run_submission": true,
      "run_status": true,
      "run_events_sse": true,
      "run_stop": true,
      "run_approval_response": true,
      "approval_events": true,
      "session_resources": true
